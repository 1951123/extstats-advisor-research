    "physical_statistics_object_count_is_separate": true,
    "screening_is_semantics_preserving": false,
    "search_deadline_seconds": 300,
    "default_execution_strategy": "incidence-incremental-greedy-v1",
    "default_B_equals_K_s": true,
    "observed_k_is_not_fixed": true
  },
  "cost_model": {
