.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Disposable out-of-tree PostgreSQL lab: builds, installs, PGDATA, sockets,
# logs, and runtime identities stay local and are never versioned.
/.runtime/

# Run products and local data are intentionally not versioned.
/runs/
/data/
!fixtures/

# Credentials must never enter manifests or the repository.
.env
*.secret
